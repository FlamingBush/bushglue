class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass  # suppress access logs

    def _send(self, code, ctype, body):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", len(b))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._send(200, "text/html; charset=utf-8", HTML)
        elif self.path == "/status":
            with _state_lock:
                board = _state["board"]
                fresh = board is not None and (time.time() - _state["board_ts"]) < 15
                self._send(200, "application/json", json.dumps({
                    "connected": _state["connected"],
                    "board": fresh,
                    "mapped": bool(fresh and board.get("map")),
                    "mode": _state["mode"],
                }))
        else:
            self._send(404, "text/plain", "not found")

    def _post_json(self):
        length = int(self.headers.get("Content-Length", 0))
        return json.loads(self.rfile.read(length))

    def do_POST(self):
        try:
            if self.path == "/fire":
                data = self._post_json()
                ok = _fire(data["valve"], int(data["ms"]))
            elif self.path == "/identify":
                data = self._post_json()
                ok = _identify(data["out"], int(data["ms"]))
            elif self.path == "/mode":
                data = self._post_json()
                ok = _set_mode(data["mode"])
            else:
                self._send(404, "text/plain", "not found")
                return
            self._send(200, "application/json", json.dumps({"ok": ok}))
        except Exception as e:
            self._send(400, "application/json", json.dumps({"ok": False, "err": str(e)}))


def main():
    global _mqttc

    ap = argparse.ArgumentParser(description="Fire control web UI")
    ap.add_argument("--broker", default="localhost")
    ap.add_argument("--port",   type=int, default=1883)
    ap.add_argument("--web-port", type=int, default=80)
    args = ap.parse_args()

    _mqttc = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)

    def on_connect(c, u, f, rc, p=None):
        with _state_lock:
            _state["connected"] = (str(rc) == "Success" or rc == 0)
        c.subscribe(TOPIC_PIPELINE_PING)
        c.subscribe(TOPIC_STATUS)
        c.subscribe(TOPIC_MODE)

    def on_disconnect(c, u, f, rc, p=None, *a):
        with _state_lock:
            _state["connected"] = False

    def on_message(c, u, msg):
        if msg.topic == TOPIC_PIPELINE_PING:
            c.publish(TOPIC_PIPELINE_PONG, "")
        elif msg.topic == TOPIC_MODE:
            try:
                m = json.loads(msg.payload).get("mode")
            except ValueError:
                m = msg.payload.decode(errors="replace").strip()
            if m in MODES:
                with _state_lock:
                    _state["mode"] = m
        elif msg.topic == TOPIC_STATUS:
            try:
                with _state_lock:
                    _state["board"] = json.loads(msg.payload)
                    _state["board_ts"] = time.time()
            except ValueError:
                pass

    _mqttc.on_connect    = on_connect
    _mqttc.on_disconnect = on_disconnect
    _mqttc.on_message    = on_message

    def _mqtt_thread():
        try:
            _mqttc.connect(args.broker, args.port, keepalive=10)
        except Exception as e:
            print(f"[firecontrol-web] MQTT connect failed: {e}")
        _mqttc.loop_forever()

    threading.Thread(target=_mqtt_thread, daemon=True).start()

    server = HTTPServer(("0.0.0.0", args.web_port), Handler)
    print(f"[firecontrol-web] http://0.0.0.0:{args.web_port}/  broker={args.broker}:{args.port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
