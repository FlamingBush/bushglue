class Handler(BaseHTTPRequestHandler):
    # keep-alive: a fresh TCP connection per tap is most of the perceived lag
    # over Wi-Fi. Safe because every response below sets Content-Length.
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, ctype, body):
        b = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._send(200, "text/html; charset=utf-8", FIRE_HTML)
        elif self.path in ("/setup", "/setup/"):
            self._send(200, "text/html; charset=utf-8", SETUP_HTML)
        elif self.path == "/status":
            self._send(200, "application/json", json.dumps(_snapshot()))
        elif self.path == "/events":
            self._events()
        else:
            self._send(404, "text/plain", "not found")

    def _events(self):
        q = queue.Queue(maxsize=8)
        with _subs_lock:
            _subs.append(q)
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "keep-alive")
            self.end_headers()
            self.wfile.write(f"data: {json.dumps(_snapshot())}\n\n".encode())
            self.wfile.flush()
            while True:
                try:
                    chunk = f"data: {q.get(timeout=10)}\n\n".encode()
                except queue.Empty:
                    chunk = b": ka\n\n"     # keep-alive so phones hold the stream
                self.wfile.write(chunk)
                self.wfile.flush()
        except Exception:
            pass                             # client went away; normal
        finally:
            with _subs_lock:
                if q in _subs:
                    _subs.remove(q)

    def _body(self):
        n = int(self.headers.get("Content-Length", 0))
        return json.loads(self.rfile.read(n) or b"{}")

    def do_POST(self):
        try:
            if self.path == "/fire":
                d = self._body()
                ok = _fire(d["valve"], int(d["ms"]))
            elif self.path == "/identify":
                d = self._body()
                ok = _identify(d["out"], int(d.get("ms", IDENTIFY_MS)))
            elif self.path == "/stop":
                self._body()
                ok = _all_stop()
            elif self.path == "/mode":
                ok = _set_mode(self._body()["mode"])
            elif self.path == "/service":
                d = self._body()
                ok, msg = _set_service(d["unit"], bool(d["on"]))
                self._send(200, "application/json",
                           json.dumps({"ok": ok, "msg" if ok else "err": msg}))
                return
            else:
                self._send(404, "text/plain", "not found")
                return
            self._send(200, "application/json", json.dumps({"ok": ok}))
        except Exception as e:
            self._send(400, "application/json",
                       json.dumps({"ok": False, "err": str(e)[:200]}))


def main():
    global _mqttc

    ap = argparse.ArgumentParser(description="Fire control web UI")
    ap.add_argument("--broker", default="localhost")
    ap.add_argument("--port", type=int, default=1883)
    ap.add_argument("--web-port", type=int, default=80)
    args = ap.parse_args()

    _mqttc = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)

    def on_connect(c, u, f, rc, p=None):
        with _state_lock:
            _state["connected"] = (str(rc) == "Success" or rc == 0)
        for t in (TOPIC_PIPELINE_PING, TOPIC_STATUS, TOPIC_MODE):
            c.subscribe(t)
        _broadcast()

    def on_disconnect(c, u, f, rc, p=None, *a):
        with _state_lock:
            _state["connected"] = False
        _broadcast()

    def on_message(c, u, msg):
        if msg.topic == TOPIC_PIPELINE_PING:
            c.publish(TOPIC_PIPELINE_PONG, "")
            return
        if msg.topic == TOPIC_MODE:
            try:
                m = json.loads(msg.payload).get("mode")
            except ValueError:
                m = msg.payload.decode(errors="replace").strip()
            if m in MODES:
                with _state_lock:
                    _state["mode"] = m
                _broadcast()
        elif msg.topic == TOPIC_STATUS:
            try:
                board = json.loads(msg.payload)
            except ValueError:
                return
            with _state_lock:
                _state["board"] = board
                _state["board_ts"] = time.time()
            _broadcast()

    _mqttc.on_connect = on_connect
    _mqttc.on_disconnect = on_disconnect
    _mqttc.on_message = on_message

    def _mqtt_thread():
        try:
            _mqttc.connect(args.broker, args.port, keepalive=10)
        except Exception as e:
            print(f"[firecontrol-web] MQTT connect failed: {e}")
        _mqttc.loop_forever()

    # The board's beacon drives the lamps; when it stops, the UI has to notice
    # on its own rather than showing a stale lit valve for ever.
    def _staleness_loop():
        was = None
        while True:
            fresh = _snapshot()["board"]
            if fresh != was:
                was = fresh
                _broadcast()
            time.sleep(2.0)

    threading.Thread(target=_mqtt_thread, daemon=True).start()
    threading.Thread(target=_service_loop, daemon=True).start()
    threading.Thread(target=_staleness_loop, daemon=True).start()

    server = ThreadingHTTPServer(("0.0.0.0", args.web_port), Handler)
    server.daemon_threads = True
    print(f"[firecontrol-web] http://0.0.0.0:{args.web_port}/  "
          f"broker={args.broker}:{args.port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
