function paint(d){{
  const armed = !!d.armed;
  const pb = document.getElementById('p-broker');
  pb.textContent = d.connected ? 'broker' : 'NO BROKER';
  pb.className = 'pill ' + (d.connected ? 'ok' : 'bad');

  const bd = document.getElementById('p-board');
  bd.textContent = d.board ? 'board' : 'NO BOARD';
  bd.className = 'pill ' + (d.board ? 'ok' : 'bad');

  const pm = document.getElementById('p-mode');
  pm.textContent = armed ? (d.mode || '—') : 'STOPPED';
  pm.className = 'pill' + (armed ? (d.mode === 'manual' ? '' : ' ok') : ' bad');

  /* lamps reflect the BOARD's own report, never what we asked for */
  VALVES.forEach(v=>{{
    const lamp = document.getElementById('lamp-'+v);
    const row  = document.getElementById('row-'+v);
    const on   = !!(d.valves && d.valves[v]);
    if(lamp) lamp.classList.toggle('on', on);
    if(row)  row.classList.toggle('lit', on);
  }});
  /* Disarmed is a hard state, not a hint: the buttons stop working and the
     page says why. The board refuses the pulses regardless. */
  document.body.classList.toggle('disarmed', !armed);
  document.querySelectorAll('.d').forEach(b=> b.disabled = !d.connected || !armed);

  const acb = document.getElementById('armcb');
  if(acb && !held('armcb', armed)){{
    acb.checked = armed;
    document.getElementById('armrow').classList.toggle('up', armed);
    document.getElementById('armrow').classList.toggle('down', !armed);
    document.getElementById('armst').textContent = armed ? 'ARMED' : 'STOPPED';
  }}

  document.querySelectorAll('.modes button').forEach(b=>
    b.classList.toggle('on', b.dataset.m === d.mode));
  /* setup-only node: absent on the fire page, and paint() must not throw
     there or the service and map updates below never run */
  const note = document.getElementById('modenote');
  if(note) note.textContent =
    d.mode==='manual'      ? 'Only this UI fires. The pipeline classifies but never opens a valve.' :
    d.mode==='interactive' ? 'The verse pipeline drives the fire. Push-to-talk is live.' :
    d.mode==='midi'        ? 'The MIDI keyboard plays the solenoids. Pipeline fire is off.' : '';

  if(d.services){{
    for(const u in d.services){{
      const on = d.services[u];
      const cb = document.getElementById('svc-'+u);
      if(cb && !held('svc-'+u, on)){{
        cb.checked = on;
        const row = document.getElementById('svcrow-'+u);
        row.classList.toggle('up', on);
        row.classList.toggle('down', !on);
        document.getElementById('st-'+u).textContent = on ? 'up' : 'down';
      }}
    }}
  }}
  const pf = document.getElementById('pf');
  if(pf && !held('pf', !!d.poof_fallback)){{
    pf.checked = !!d.poof_fallback;
    document.getElementById('pfrow').classList.toggle('up', !!d.poof_fallback);
    document.getElementById('pfst').textContent = d.poof_fallback ? 'ON' : 'off';
  }}
  /* The fire page must say so too — tapping POOF will fire the jets, and
     that is not something to discover by watching the rig. */
  VALVES.filter(v=>v.startsWith('poof')).forEach(v=>{{
    const row = document.getElementById('row-'+v);
    if(row) row.classList.toggle('sub', !!d.poof_fallback);
  }});
  if(d.map){{
    for(const name in d.map){{
      const el = document.getElementById('idmap-'+d.map[name]);
      if(el) el.textContent = name;
    }}
  }}
}}

function startPoll(){{
  if(pollTimer) return;
  const tick = ()=> fetch('/status').then(r=>r.json()).then(paint).catch(()=>{{}});
  tick();
  pollTimer = setInterval(tick, 2000);
}}

function connect(){{
  try{{ es = new EventSource('/events'); }}catch(e){{ return startPoll(); }}
  es.onmessage = e => {{ esFails = 0; try{{ paint(JSON.parse(e.data)); }}catch(_){{}} }};
  es.onerror = () => {{
    es.close();
