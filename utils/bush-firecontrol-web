# ── markup ─────────────────────────────────────────────────────────────────
def _fmt(ms):
    return f"{ms / 1000:g}s" if ms >= 1000 else f"{ms}"


def _valve_rows():
    out = []
    for valve, group in VALVES:
        btns = "\n".join(
            f'<button class="d" onpointerdown="fire(\'{valve}\',{ms},event)">'
            f'{_fmt(ms)}</button>'
            for ms in DURATIONS[group]
        )
        out.append(
            f'<div class="row {group}" id="row-{valve}">'
            f'<div class="vname"><i class="lamp" id="lamp-{valve}"></i>{valve}</div>'
            f'<div class="dbtns">{btns}</div></div>'
        )
    return "\n".join(out)


def _ident_buttons():
    return "\n".join(
        f'<button class="idbtn" onpointerdown="ident({i})">'
        f'ch{i}<em id="idmap-{i}">·</em></button>'
        for i in range(NUM_OUTPUTS)
    )


def _service_rows():
    return "\n".join(
        f'<label class="svc" id="svcrow-{u}">'
        f'<input type="checkbox" id="svc-{u}" onchange="toggleSvc(\'{u}\',this.checked)">'
        f'<span>{label}</span><em id="st-{u}">·</em></label>'
        for label, u in SERVICES
    )


