#!/usr/bin/env python3
"""
bush-firecontrol-web: touch-friendly web UI for phone-based flame control.
Serves on port 8080. Publishes to MQTT on button tap.

Seven solenoids, each individually addressed: flare1-3, bigjet1-3, poof1.
Each column has a selector for which valve of that type to fire, so the
duration buttons keep the same positions they always had.

The IDENTIFY panel fires a RAW relay channel, bypassing the name->channel
map entirely. That is how you find out which physical valve a channel drives
after the loom is assembled; see utils/bush-valve-id for the guided version
that also publishes the resulting map.
"""
import argparse
import json
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
import paho.mqtt.client as mqtt

TOPIC_FLAME         = "bush/flame/pulse"
TOPIC_IDENTIFY      = "bush/flame/identify"
TOPIC_MAP           = "bush/flame/map"
TOPIC_STATUS        = "bush/flame/status"
TOPIC_PIPELINE_PING = "bush/pipeline/ping"
TOPIC_PIPELINE_PONG = "bush/pipeline/pong"
TOPIC_MODE          = "bush/mode"

# Run modes. Retained, so the rig comes back in whatever mode it was left in.
#   interactive — the pipeline runs itself: speak, get a verse, get fire
#   manual      — only these fire-control UIs may fire; the pipeline and the
#                 keyboard stay quiet so you can work on the rig safely
#   midi        — the MIDI keyboard plays the solenoids
MODES = ["manual", "interactive", "midi"]
DEFAULT_MODE = "interactive"

BIGJET_DURATIONS = [50, 100, 200, 300, 500, 800, 1000, 1500, 2000, 3000, 5000, 8000]
FLARE_DURATIONS  = [50, 100, 200, 300, 500, 800, 1000, 1500, 2000, 3000, 5000, 8000]
POOF_DURATIONS   = [20, 30, 50, 75, 100, 150, 200, 250, 300, 350, 400, 450]

# Must match OUTPUT_PINS in firmware/relay-control/CIRCUITPY/code.py
NUM_OUTPUTS = 7
IDENTIFY_MS = 250

_state = {"connected": False, "last": None, "board": None, "board_ts": 0.0,
          "mode": DEFAULT_MODE}
_state_lock = threading.Lock()
_mqttc = None


def _fire(valve, ms):
    if _mqttc and _state["connected"]:
        _mqttc.publish(TOPIC_FLAME, json.dumps({"valve": valve, "ms": ms}), qos=0)
        with _state_lock:
            _state["last"] = {"valve": valve, "ms": ms, "t": time.time()}
        return True
    return False


def _identify(out, ms):
    if _mqttc and _state["connected"]:
        _mqttc.publish(TOPIC_IDENTIFY, json.dumps({"out": int(out), "ms": int(ms)}), qos=0)
        return True
    return False


def _set_mode(mode):
    if mode not in MODES:
        return False
    if _mqttc and _state["connected"]:
        # Retained: the mode is rig state, not a transient command.
        _mqttc.publish(TOPIC_MODE, json.dumps({"mode": mode}), qos=0, retain=True)
        with _state_lock:
            _state["mode"] = mode
        return True
    return False


def _fmt(ms):
    return f"{ms/1000:.1g}s" if ms >= 1000 else f"{ms}ms"


def _buttons(durations, css_class):
    # The valve is chosen at tap time from the column's selector, so the
    # button only carries the duration.
    return "\n".join(
        f'<button class="btn {css_class}" '
        f'ontouchstart="fire(\'{css_class}\',{ms})" '
        f'onclick="fire(\'{css_class}\',{ms})">'
        f'{_fmt(ms)}</button>'
        for ms in durations
    )


def _selector(kind, n):
    if n < 2:
        return ""
    opts = "\n".join(
        f'<button class="sel{" on" if i == 1 else ""}" data-kind="{kind}" '
        f'data-n="{i}" onclick="pick(\'{kind}\',{i})">{i}</button>'
        for i in range(1, n + 1)
    )
    return f'<div class="selrow" id="sel-{kind}">{opts}</div>'


def _ident_buttons():
    return "\n".join(
        f'<button class="idbtn" onclick="ident({i})">ch{i}</button>'
        for i in range(NUM_OUTPUTS)
    )


