<script>
const VALVES = {valves_json};
let es = null, esFails = 0, pollTimer = null;

/* A control the operator just touched is held against incoming status frames
   until the board actually confirms the new value — not for a guessed number
   of milliseconds. A frame that predates the change would otherwise flip the
   control back, and it reads as "the button does nothing".

   Waiting for confirmation rather than a timer matters because the board may
   only report on its 5 s beacon, and any fixed hold shorter than that loses
   the race. The deadline is a backstop for a board that never confirms at
   all. activeElement is not enough on its own either: a tapped checkbox does
   not reliably keep focus on mobile. */
const pending = {{}};
function hold(id, want){{ pending[id] = {{want: want, until: Date.now() + 12000}}; }}
function held(id, actual){{
  const p = pending[id];
  if(!p) return false;
  if(p.want === actual || Date.now() > p.until){{ delete pending[id]; return false; }}
  return true;
}}

let logTimer = null;
function say(msg, cls){{
  const el = document.getElementById('log');
  el.textContent = msg;
  el.className = cls || '';
  clearTimeout(logTimer);
  logTimer = setTimeout(()=>{{ el.textContent='ready'; el.className=''; }}, 4000);
}}

function flash(el){{
  if(!el) return;
  el.classList.add('hit');
  setTimeout(()=>el.classList.remove('hit'), 120);
}}

function post(path, body){{
  return fetch(path, {{method:'POST', headers:{{'Content-Type':'application/json'}},
                       body:JSON.stringify(body), keepalive:true}}).then(r=>r.json());
}}

function fmt(ms){{ return ms>=1000 ? (ms/1000)+'s' : ms+'ms'; }}

function fire(valve, ms, ev){{
  if(ev){{ ev.preventDefault(); flash(ev.currentTarget); }}
  post('/fire', {{valve, ms}})
    .then(d=> say(d.ok ? (valve+'  '+fmt(ms)) : 'NOT SENT — broker down', d.ok?'':'err'))
    .catch(()=> say('NOT SENT — request failed','err'));
}}

function ident(ch){{
  post('/identify', {{out:ch, ms:{ident_ms}}})
    .then(d=> say(d.ok ? ('identify channel '+ch) : 'NOT SENT', d.ok?'':'err'))
    .catch(()=> say('NOT SENT','err'));
}}

function allStop(){{
  const b = document.getElementById('stop');
  b.classList.add('hit');
  setTimeout(()=>b.classList.remove('hit'), 220);
  if(navigator.vibrate) navigator.vibrate(60);
  post('/stop', {{}})
    .then(d=> say(d.ok ? 'ALL STOP SENT' : 'ALL STOP FAILED — broker down', d.ok?'warn':'err'))
