#!/usr/bin/env python3
"""
bush-firecontrol-web: phone-first flame control for the installation.

Serves on port 80. Every control is a thin wrapper over an MQTT publish.

Design notes, because this drives real fire:

  * Valves are addressed directly. There is no "which of the three" selector
    to forget you left set — every button names the valve it fires. A hidden
    mode is how you light the wrong jet.
  * The valve lamps show what the RELAY BOARD reports, from its own 5 s
    beacon — not what we asked for. If a command is lost the lamp stays dark
    and you can see that it did not happen.
  * The board going quiet is shown as loudly as losing the broker. Silence
    from the hardware must never look like everything is fine.
  * ALL STOP is always on screen, never behind a tab, and publishes to a topic
    the firmware handles before anything else in its queue.
  * State is pushed over Server-Sent Events rather than polled, so a lamp
    tracks reality within a beacon instead of up to a poll interval late.
  * Nothing on the fire path touches a subprocess or waits on a slow lock;
    service state is gathered on a background thread and served from cache.

The fire page at / is what a member of the public is handed, so it links
nowhere. /setup and the endpoints behind it (/service, /mode, /identify,
/poof-fallback) sit behind a PIN — SETUP_PIN, default "BURN", which folds onto
2876 on a phone keypad so either keyboard works.

What that PIN is worth: it keeps a curious visitor out of the commissioning
screen. It is not real security. The page is plain HTTP, so the PIN and the
session cookie both cross the network in clear and anyone who can watch the
Wi-Fi has them. If the installation network is genuinely public, bind the
setup routes to an interface the public cannot reach rather than relying on
this.

/fire and /stop are deliberately left open. The fire page is the public
interaction, and putting an emergency stop behind a login is worse than having
no login at all.
"""
import argparse
import hmac
import json
import queue
import secrets as _secrets
import os
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import paho.mqtt.client as mqtt

# ── topics ─────────────────────────────────────────────────────────────────
TOPIC_FLAME         = "bush/flame/pulse"
TOPIC_IDENTIFY      = "bush/flame/identify"
TOPIC_STOP          = "bush/flame/stop"
TOPIC_POOF_FB       = "bush/flame/poof-fallback"
TOPIC_ARMED         = "bush/flame/armed"
TOPIC_STATUS        = "bush/flame/status"
TOPIC_MODE          = "bush/mode"
TOPIC_PIPELINE_PING = "bush/pipeline/ping"
TOPIC_PIPELINE_PONG = "bush/pipeline/pong"

# ── rig layout ─────────────────────────────────────────────────────────────
# (valve, group) in display order. Must match the firmware's valve names.
VALVES = [
    ("flare1", "flare"), ("flare2", "flare"), ("flare3", "flare"),
    ("bigjet1", "bigjet"), ("bigjet2", "bigjet"), ("bigjet3", "bigjet"),
    ("poof1", "poof"),
]
# Durations offered per group. Short first — the common case is a quick bark.
DURATIONS = {
    "flare":  [100, 300, 800, 1500, 3000],
    "bigjet": [100, 300, 800, 1500, 3000],
    "poof":   [30, 75, 150, 300, 450],
}
NUM_OUTPUTS = 8          # must match OUTPUT_PINS in the relay firmware
IDENTIFY_MS = 250

# The board beacons every 5 s; treat it as gone after three missed beacons.
BOARD_STALE_S = 16

# ── setup PIN ──────────────────────────────────────────────────────────────
# Letters are folded onto phone-keypad digits, so "BURN" and "2876" are the
# same PIN and either keyboard works.
#
# This keeps a curious visitor out of the commissioning screen. It is NOT
# meaningful security: the page is plain HTTP, so the PIN and the session
# cookie both cross the network in clear, and anyone who can watch the Wi-Fi
# or shoulder-surf the entry has it. ALL STOP and the fire page are
# deliberately left open — an emergency control behind a login is worse than
# no login.
SETUP_PIN = os.environ.get("SETUP_PIN", "BURN")

_KEYPAD = {}
for _digit, _letters in (("2", "ABC"), ("3", "DEF"), ("4", "GHI"), ("5", "JKL"),
                         ("6", "MNO"), ("7", "PQRS"), ("8", "TUV"), ("9", "WXYZ")):
    for _c in _letters:
        _KEYPAD[_c] = _digit


def _normalise_pin(raw):
    out = []
    for ch in str(raw).upper():
        if ch.isdigit():
            out.append(ch)
        elif ch in _KEYPAD:
            out.append(_KEYPAD[ch])
    return "".join(out)


PIN_DIGITS = _normalise_pin(SETUP_PIN)
# One session token per process; a restart signs everyone out, which is the
# right default for a rig that gets power-cycled between builds.
_SESSION = _secrets.token_urlsafe(18)
COOKIE = "bushfc"

# Four digits is 10k guesses. Back off hard so that is not a minute's work.
_auth_fails = {"n": 0, "until": 0.0}
_auth_lock = threading.Lock()

MODES = ["manual", "interactive", "midi"]
DEFAULT_MODE = "interactive"

# Only these units may be toggled. An allowlist rather than a free-form unit
# name, because this endpoint answers anyone on the installation network and
# systemctl takes arbitrary arguments.
SERVICES = [
    ("STT",         "bush-stt"),
    ("PTT button",  "bush-ptt"),
    ("MIDI",        "bush-midi"),
    ("Verse",       "bush-t2v"),
    ("TTS",         "bush-tts"),
    ("Sentiment",   "bush-sentiment"),
    ("Valves",      "bush-variable-valves"),
    ("Lights",      "mqtt-pixelblaze-bridge"),
    ("Audio agent", "bush-audio-agent"),
    ("ChromaDB",    "chromadb"),
]
SERVICE_UNITS = {u for _, u in SERVICES}

# ── shared state ───────────────────────────────────────────────────────────
_state = {"connected": False, "board": None, "board_ts": 0.0, "mode": DEFAULT_MODE}
_state_lock = threading.Lock()
_mqttc = None

_svc_cache = {u: False for _, u in SERVICES}
_svc_lock = threading.Lock()

# Every SSE listener gets its own bounded queue; a slow phone is dropped
# rather than allowed to back the publisher up.
_subs = []
_subs_lock = threading.Lock()


def _snapshot():
    with _state_lock:
        board = _state["board"]
        age = time.time() - _state["board_ts"]
        fresh = board is not None and age < BOARD_STALE_S
        mode = _state["mode"]
        connected = _state["connected"]
    return {
        "connected": connected,
        "board": fresh,
        "board_age": round(age, 1) if board is not None else None,
        "valves": (board.get("valves") or {}) if fresh else {},
        "map": (board.get("map") or {}) if fresh else {},
        "poof_fallback": bool(board.get("poof_fallback")) if fresh else False,
        # Unknown board state reads as NOT armed. Anything else would show a
        # green light for a rig we cannot hear from.
        "armed": bool(board.get("armed")) if fresh else False,
        "mode": mode,
        "services": _service_states(),
    }


def _broadcast():
    payload = json.dumps(_snapshot())
    with _subs_lock:
        dead = []
        for q in _subs:
            try:
                q.put_nowait(payload)
            except queue.Full:
                dead.append(q)
        for q in dead:
            _subs.remove(q)


# ── publishing ─────────────────────────────────────────────────────────────
def _pub(topic, payload, retain=False):
    if _mqttc and _state["connected"]:
        _mqttc.publish(topic, payload, qos=0, retain=retain)
        return True
    return False


def _fire(valve, ms):
    if valve not in {v for v, _ in VALVES}:
        return False
    return _pub(TOPIC_FLAME, json.dumps({"valve": valve, "ms": int(ms)}))


def _identify(out, ms):
    out = int(out)
    if not 0 <= out < NUM_OUTPUTS:
        return False
    return _pub(TOPIC_IDENTIFY, json.dumps({"out": out, "ms": int(ms)}))


def _all_stop():
    """Drop everything now, and latch it disarmed."""
    # Immediate action first — the retained disarm is for persistence, not for
    # speed, and must never be what stands between a person and the gas going
    # off.
    ok = _pub(TOPIC_STOP, "")
    _pub(TOPIC_ARMED, json.dumps({"armed": False}), retain=True)
    return ok


def _set_armed(on):
    return _pub(TOPIC_ARMED, json.dumps({"armed": bool(on)}), retain=True)


def _set_poof_fallback(on):
    # Retained: a broken poofer stays broken across a reboot, and the
    # substitution has to survive with it.
    return _pub(TOPIC_POOF_FB, json.dumps({"enabled": bool(on)}), retain=True)


def _set_mode(mode):
    if mode not in MODES:
        return False
    if _pub(TOPIC_MODE, json.dumps({"mode": mode}), retain=True):
        with _state_lock:
            _state["mode"] = mode
        _broadcast()
        return True
    return False


# ── services ───────────────────────────────────────────────────────────────
def _probe_services():
    """One systemctl call for every unit: ~9 ms instead of ~53 ms."""
    units = [u for _, u in SERVICES]
    try:
        r = subprocess.run(["systemctl", "is-active", *units],
                           capture_output=True, text=True, timeout=10)
    except Exception:
        return None
    lines = r.stdout.strip().split("\n")
    if len(lines) != len(units):
        return None
    return {u: line.strip() == "active" for u, line in zip(units, lines)}


def _service_states():
    with _svc_lock:
        return dict(_svc_cache)


def _refresh_services():
    got = _probe_services()
    if got is not None:
        with _svc_lock:
            _svc_cache.update(got)
        return True
    return False


def _set_service(unit, on):
    if unit not in SERVICE_UNITS:
        return False, "unknown unit"
    action = "start" if on else "stop"
    try:
        r = subprocess.run(["sudo", "-n", "systemctl", action, unit],
                           capture_output=True, text=True, timeout=30)
    except Exception as e:
        return False, str(e)[:200]
    if r.returncode != 0:
        return False, (r.stderr or r.stdout).strip()[:200]
    _refresh_services()
    _broadcast()
    return True, action


def _service_loop():
    while True:
        if _refresh_services():
            _broadcast()
        time.sleep(3.0)


# ── auth ───────────────────────────────────────────────────────────────────
def _check_pin(raw):
    """Constant-time PIN check with lockout. Returns (ok, retry_after_s)."""
    now = time.time()
    with _auth_lock:
        if now < _auth_fails["until"]:
            return False, int(_auth_fails["until"] - now) + 1
    ok = hmac.compare_digest(_normalise_pin(raw), PIN_DIGITS)
    with _auth_lock:
        if ok:
            _auth_fails["n"] = 0
            _auth_fails["until"] = 0.0
        else:
            _auth_fails["n"] += 1
            # 3 free tries, then escalating: 2s, 4s, 8s ... capped at a minute.
            if _auth_fails["n"] > 3:
                delay = min(2 ** (_auth_fails["n"] - 3), 60)
                _auth_fails["until"] = now + delay
    return ok, 0


