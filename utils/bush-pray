#!/usr/bin/env python3
"""
Synthesize a phrase to WAV (or use an existing WAV) and inject it into the
Bush pipeline by playing it into the ALSA loopback device that stt-service.py
is capturing from.

Generated WAVs are saved to WAVS_DIR (default: ~/wavs/) for future replay.

Usage:
    bush-pray --phrase "what is the meaning of fire"
    bush-pray --file ~/wavs/what_is_the_meaning_of_fire.wav

Environment:
    WAVS_DIR        where to save generated WAVs  (default: ~/wavs)
    LOOPBACK_DEVICE ALSA playback device to write into  (default: hw:3,0)
    SETTLE_S        seconds to wait after playback before restoring the STT
                    device, so the tail of the utterance is not cut off
                    (default: 2.0)
    SWITCH_S        extra settle after bush-stt reports the new device is
                    open, before pressing PTT (default: 1.5)
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

WAVS_DIR = Path(os.environ.get("WAVS_DIR", Path.home() / "wavs"))
LOOPBACK_DEVICE = os.environ.get("LOOPBACK_DEVICE", "loopback-inject")
LOOPBACK_SOURCE = "loopback-inject.monitor"
MQTT_BROKER = os.environ.get("MQTT_BROKER", "localhost")

# sox exiting means the audio reached the null sink, NOT that bush-stt has
# consumed it: capture is still draining a 0.5 s chunk at 48 kHz through
# RNNoise and the 48->16 resampler, and the VAD needs its min_silence window
# (600 ms) of quiet before it will emit. Restoring the device immediately
# tears the capture stream down mid-utterance — the VAD flushes a truncated
# buffer and Whisper returns empty text. Short phrases lose proportionally
# more, which is why this showed up as an intermittent transcript failure.
SETTLE_S = float(os.environ.get("SETTLE_S", "2.0"))

# Switching the STT device makes bush-stt tear down its capture process and
# spawn a new one. Under VAD endpointing the delay was invisible — the VAD has
# no fixed window, so it endpointed whenever speech showed up. PTT does have a
# fixed window, so pressing before capture is live puts the phrase in a dead
# zone: only trailing silence gets buffered and the engine returns empty text.
#
# bush-stt publishes {"status": "ok"} once its capture has yielded a first
# chunk, so wait for that. It is necessary but not sufficient: a PulseAudio
# monitor hands over silence the instant it is opened, so "first chunk" can
# arrive before the stream is really carrying the sink. Measured with a
# parallel parecord, the injected phrase lands 3-4 s after the switch. SWITCH_S
# is therefore a margin over that startup race, not a proof — which is
# acceptable because only the test harness switches devices. The production
# path (physical button, microphone, no device change) has no such race.
SWITCH_S = float(os.environ.get("SWITCH_S", "3.0"))
DEVICE_READY_TIMEOUT_S = float(os.environ.get("DEVICE_READY_TIMEOUT_S", "20"))
TOPIC_STT_DEVICE = "bush/audio/stt/device"
TOPIC_SET_STT_DEVICE = "bush/audio/stt/set-device"
TOPIC_PTT = "bush/pipeline/stt/ptt"


def phrase_to_filename(phrase: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "_", phrase.lower().strip()).strip("_")
    return f"{slug}.wav"


def synthesize(phrase: str, out_path: Path) -> None:
    # Write to a sibling tmp path and rename on success — sox writes the WAV
    # header up-front and only finalizes on close, so a crash mid-encode would
    # otherwise leave a 0-byte or truncated file at the cache path. Tmp name
    # keeps the .wav suffix because sox infers output format from extension.
    tmp_path = out_path.with_name(f"{out_path.stem}.tmp{out_path.suffix}")
    espeak = subprocess.Popen(
        ["espeak-ng", "-v", "en-us", "-s", "130", "--stdout", phrase],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    try:
        subprocess.run(
            ["sox", "-t", "wav", "-", "-r", "16000", "-c", "1", "-b", "16", str(tmp_path)],
            stdin=espeak.stdout,
            check=True,
        )
        espeak.stdout.close()
        espeak.wait()
        tmp_path.rename(out_path)
    finally:
        if tmp_path.exists():
            tmp_path.unlink()


def get_stt_device() -> str | None:
    """Query the current STT input device from the retained MQTT topic."""
    try:
        result = subprocess.run(
            ["mosquitto_sub", "-h", MQTT_BROKER, "-t", TOPIC_STT_DEVICE,
             "-C", "1", "-W", "3"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode == 0 and result.stdout.strip():
            data = json.loads(result.stdout.strip())
            return data.get("device")
    except (subprocess.TimeoutExpired, json.JSONDecodeError, Exception) as e:
        print(f"[bush-pray] Failed to query STT device: {e}", flush=True)
    return None


def wait_for_stt_device(device: str, timeout: float = DEVICE_READY_TIMEOUT_S) -> bool:
    """Block until bush-stt reports *device* open, or timeout. True if ready."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            r = subprocess.run(
                ["mosquitto_sub", "-h", MQTT_BROKER, "-t", TOPIC_STT_DEVICE,
                 "-C", "1", "-W", "2"],
                capture_output=True, text=True, timeout=4,
            )
            d = json.loads(r.stdout.strip() or "{}")
            if d.get("device") == device and d.get("status") == "ok":
                return True
        except Exception:
            pass
        time.sleep(0.25)
    print(f"[bush-pray] WARNING: {device} not ready after {timeout:g}s", flush=True)
    return False


def set_ptt(pressed: bool) -> None:
    """Bracket the injection with a synthetic button press.

    Harmless when bush-stt is VAD-endpointed — it ignores this topic unless
    STT_ENDPOINT=ptt built a PttEndpointer — and required when it is not,
    since otherwise nothing ever opens an utterance.
    """
    subprocess.run(
        ["mosquitto_pub", "-h", MQTT_BROKER, "-t", TOPIC_PTT,
         "-m", json.dumps({"pressed": pressed, "ts": time.time()})],
        timeout=5,
    )


def set_stt_device(device: str) -> None:
    """Tell the STT service to switch input device."""
    payload = json.dumps({"device": device})
    subprocess.run(
        ["mosquitto_pub", "-h", MQTT_BROKER, "-t", TOPIC_SET_STT_DEVICE,
         "-m", payload],
        timeout=5,
    )


def main():
    parser = argparse.ArgumentParser(
        description="Synthesize or load a WAV and play it into the loopback mic device."
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--phrase", help="Text to synthesize and inject")
    group.add_argument("--file", help="Path to existing WAV file")
    args = parser.parse_args()

    if args.phrase:
        WAVS_DIR.mkdir(parents=True, exist_ok=True)
        wav = WAVS_DIR / phrase_to_filename(args.phrase)
        # Treat zero-byte cache hits as missing — historically these came from
        # crashed synth runs and made sox fail silently.
        if not wav.exists() or wav.stat().st_size == 0:
            print(f"[bush-pray] Synthesizing → {wav}")
            synthesize(args.phrase, wav)
        else:
            print(f"[bush-pray] Using cached  → {wav}")
    else:
        wav = Path(args.file).expanduser()
        if not wav.exists():
            print(f"[bush-pray] File not found: {wav}", file=sys.stderr)
            sys.exit(1)

    # Switch STT to loopback source before playing, restore after
    previous_device = get_stt_device()
    switched = previous_device and previous_device != LOOPBACK_SOURCE
    if switched:
        print(f"[bush-pray] Switching STT device {previous_device} → {LOOPBACK_SOURCE}")
        set_stt_device(LOOPBACK_SOURCE)
        print("[bush-pray] Waiting for capture to come up")
        wait_for_stt_device(LOOPBACK_SOURCE)
        time.sleep(SWITCH_S)

    try:
        print("[bush-pray] PTT down")
        set_ptt(True)
        print(f"[bush-pray] Playing into {LOOPBACK_DEVICE}")
        subprocess.run(
            ["sox", str(wav), "-t", "pulseaudio", LOOPBACK_DEVICE],
            check=True,
        )
        # Settle before releasing, so the capture chain has drained the tail
        # of the phrase into the endpointer's buffer.
        print(f"[bush-pray] Settling {SETTLE_S:g}s")
        time.sleep(SETTLE_S)
    finally:
        print("[bush-pray] PTT up")
        set_ptt(False)
        if switched:
            print(f"[bush-pray] Restoring STT device → {previous_device}")
            set_stt_device(previous_device)


if __name__ == "__main__":
    main()
