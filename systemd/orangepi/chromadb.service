[Unit]
Description=ChromaDB Vector Database
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=orangepi
ExecStart=/home/orangepi/bushglue/.venv/bin/chroma run --path /home/orangepi/bushglue/data/chromadb
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
